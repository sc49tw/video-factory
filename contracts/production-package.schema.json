{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/production-package.schema.json",
  "title": "LLFC Production Package",
  "type": "object",
  "additionalProperties": true,
  "required": ["draftId", "series", "subtype", "title", "language", "level", "summary", "characters", "scenes"],
  "properties": {
    "draftId": {"type": "string", "pattern": "^DRAFT-[0-9]{8}-[0-9]{3}$"},
    "series": {"const": "LLFC"},
    "subtype": {"type": "string", "minLength": 1},
    "title": {"$ref": "#/$defs/plainText"},
    "language": {"enum": ["en"]},
    "level": {"enum": ["A2"]},
    "summary": {"$ref": "#/$defs/plainText"},
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["name", "visualDescription"],
        "properties": {
          "name": {"$ref": "#/$defs/plainText"},
          "visualDescription": {"$ref": "#/$defs/plainText"}
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["scene", "imageDescription", "imagePrompt", "sentences"],
        "properties": {
          "scene": {"type": "integer", "minimum": 1},
          "imageDescription": {"$ref": "#/$defs/plainText"},
          "imagePrompt": {
            "allOf": [
              {"$ref": "#/$defs/plainText"},
              {
                "not": {
                  "pattern": "(add|Add|include|Include|show|Show|display|Display|render|Render|write|Write|with|With|containing|Containing).{0,60}(caption|Caption|subtitle|Subtitle|logo|Logo|embedded text|Embedded text|text overlay|Text overlay|on-screen text|On-screen text)"
                }
              }
            ]
          },
          "sentences": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/plainText"}
          }
        }
      }
    }
  },
  "$defs": {
    "plainText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*```)(?!\\s*#{1,6}\\s)(?!\\s*[-*]\\s)[\\s\\S]+$"
    }
  },
  "x-runtimeValidation": {
    "sequentialSceneNumbers": true,
    "implementation": "src/production-package.mjs"
  }
}
