{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/essay-episode.schema.json",
  "title": "Essay Narration Episode",
  "type": "object",
  "additionalProperties": true,
  "required": ["episode", "series", "subtype", "title", "language", "renderMode", "sections"],
  "properties": {
    "schemaVersion": {"type": "string"},
    "episode": {"$ref": "#/$defs/episodeId"},
    "series": {"const": "ESSY"},
    "subtype": {"const": "essay"},
    "title": {"$ref": "#/$defs/plainText"},
    "language": {"enum": ["en"]},
    "renderMode": {"const": "essay-narration"},
    "topic": {"type": ["string", "null"]},
    "targetDurationSec": {"type": "number", "minimum": 30, "maximum": 3600},
    "voice": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "provider": {"enum": ["edge"]},
        "voice": {"type": "string"},
        "rate": {"type": "string"},
        "pitch": {"type": "string"},
        "volume": {"type": "string"},
        "sampleRate": {"type": "integer", "minimum": 8000}
      }
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {"type": "integer", "minimum": 320},
        "height": {"type": "integer", "minimum": 240},
        "fps": {"type": "integer", "minimum": 12, "maximum": 60}
      }
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "path": {"type": "string"},
        "volume": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "subtitles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["burned", "sidecar", "both"]},
        "maxCharsPerLine": {"type": "integer", "minimum": 10, "maximum": 80}
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "type"],
        "properties": {
          "id": {"type": "string"},
          "type": {"enum": ["web", "youtube", "book", "note", "other"]},
          "ref": {"type": "string"},
          "title": {"type": "string"}
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "narration"],
        "properties": {
          "id": {"$ref": "#/$defs/plainText"},
          "heading": {"type": "string"},
          "narration": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": ["text"],
              "properties": {
                "id": {"type": "string"},
                "text": {"$ref": "#/$defs/plainText"},
                "pauseAfterSec": {"type": "number", "minimum": 0, "maximum": 10},
                "tts": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "voice": {"type": "string"},
                    "rate": {"type": "string"},
                    "pitch": {"type": "string"},
                    "volume": {"type": "string"}
                  }
                }
              }
            }
          },
          "visual": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "image": {"type": "string"},
              "mood": {"type": "string"},
              "keywords": {"type": "array", "items": {"type": "string"}},
              "motion": {"type": "string"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "episodeId": {"type": "string", "pattern": "^ESSY-[0-9]{4}$"},
    "plainText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![\\s\\S]*```)[\\s\\S]+$"
    }
  },
  "x-runtimeValidation": {
    "implementation": "src/essay-episode.mjs"
  }
}