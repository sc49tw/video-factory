{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/visual-plan.schema.json",
  "title": "Essay Visual Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "episode", "series", "planning", "shots"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "episode": {"$ref": "#/$defs/episodeId"},
    "series": {"const": "ESSY"},
    "createdAt": {"type": "string"},
    "sourceLessonSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "planning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "durationSource", "targetShots"],
      "properties": {
        "strategy": {"const": "sentence-boundary-proportional"},
        "durationSource": {"const": "ffprobe"},
        "targetShots": {"type": "integer", "minimum": 1}
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "index",
          "sentenceId",
          "sectionId",
          "image",
          "startSec",
          "speechEndSec",
          "endSec"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^shot-[0-9]{3,}$"},
          "index": {"type": "integer", "minimum": 0},
          "sentenceId": {"type": "string", "minLength": 1},
          "sectionId": {"type": "string"},
          "image": {"type": "string", "minLength": 1},
          "motionIndex": {"type": "integer", "minimum": 0},
          "startSec": {"type": "number", "minimum": 0},
          "speechEndSec": {"type": "number", "minimum": 0},
          "endSec": {"type": "number", "minimum": 0},
          "durationSec": {
            "description": "Optional manual shot duration override. Reserved for future extension; automatic planning never emits it.",
            "type": "number",
            "exclusiveMinimum": 0
          },
          "pauseAfterSec": {"type": "number", "minimum": 0},
          "cues": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["startSec", "endSec", "text"],
              "properties": {
                "startSec": {"type": "number", "minimum": 0},
                "endSec": {"type": "number", "minimum": 0},
                "text": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "episodeId": {"type": "string", "pattern": "^ESSY-[0-9]{4}$"}
  },
  "x-runtimeValidation": {
    "implementation": "src/visual-plan.mjs"
  }
}
