# ============================================================
# video-factory push policy — see docs/REPOSITORY_POLICY.md
# Semantics: keep pipeline + rules + canonical inputs + decisions.
# Do NOT track regenerable artifacts / downloaded media.
# ============================================================

# ---- Generated media and build artifacts ----
node_modules/
*.mp4
output/
projects/**/generated/
projects/**/render/
projects/**/output/

# ---- Local secrets / environment variables ----
.env
.env.*
!.env.example

# ---- Minor OS / editor cruft ----
.DS_Store

# ---- Derived / regenerated artifacts (semantic directories) ----
# TTS narration: <EP>/audio/ holds ONLY generated sentence mp3 + cue json.
# Verified — the whole ROOT-level dir is safe to ignore. Uses single * (not **)
# so deep assets/audio/ trees (bundled sfx) stay under B, not this rule.
projects/*/audio/

# Per-shot intermediate encodes + concat inputs / TTS caches
projects/**/segments/
projects/**/temp/

# Generated subtitle passes / cue files (*.srt, *.vtt, per-cue json).
# Scoped to the CONTENTS, not the directory, so the canonical hand-authored
# translation SOURCES below can be re-included — git cannot re-include a file
# whose parent directory is excluded.
#   zh-TW.json            approved Traditional Chinese wording (per-cue + parent)
#   zh-TW-cue-splits.json approved Chinese segmentation across DP cue boundaries
# Neither is regenerable: no tool authors the wording or the split points, and
# the bilingual SRT is derived FROM them. The generated bilingual/en SRT lives in
# projects/<EP>/temp/ and stays ignored.
projects/**/subtitles/*
!projects/**/subtitles/zh-TW*.json

# QA screenshot / image artifacts ONLY.
# Scoped to images so future qa/*.md and qa/*.json decision records stay tracked.
projects/**/qa/*.png
projects/**/qa/*.jpg
projects/**/qa/*.jpeg
projects/**/qa/*.webp

# Machine-generated render/QA logs only.
# retrospective.json / final-assembly.json / manual decision metadata remain tracked.
projects/**/logs/*.log

# ---- Downloaded external assets ----
assets/audio/raw/
projects/**/sourcing/downloads/
projects/**/assets/audio/sfx/

# ---- Generated audio / diagnostic media (path-specific, see docs/REPOSITORY_POLICY.md) ----
/temp/
projects/*/music/*.wav
projects/*/music/candidates/
projects/*/audition/*.mp3

# ---- Ambiguous — MANUAL decision, NOT auto-excluded ----
# projects/<EP>/source/*.png        content/manual images (kept)
# inbox/<EP>/*.png                   content/manual images (kept)
# assets/images/**                   reusable vs per-episode (manual)
# assets/overlays/**                 reusable source binary (kept)
# templates/**                       asset templates (manual)
