    {
      "id": "1",
      "timecode": "00:00:00,100 --> 00:00:03,921",
      "english": "What if one day your body can no longer take you where you want to go?",
      "zh": "如果有一天，你的身體無法再帶你去想去的地方？",
      "hasZh": true,
      "placeholder": false,
      "mappedToEnglish": true,
      "mappedToZhKey": true,
      "zhKeyValue": "如果有一天，你的身體無法再帶你去想去的地方？"
    },
    {
      "id": "2",
      "timecode": "00:00:04,908 --> 00:00:08,005",
      "english": "What if you wake up and there is nowhere you want to go anyway?",
      "zh": "如果你醒來，發現根本沒有想去的地方？",
      "hasZh": true,
      "placeholder": false,
      "mappedToEnglish": true,
      "mappedToZhKey": true,
      "zhKeyValue": "如果你醒來，發現根本沒有想去的地方？"
    },
    {
      "id": "3",
      "timecode": "00:00:08,985 --> 00:00:13,147",
      "english": "And when so much of the person you used to be is gone, what is still there?",
      "zh": "當當年的你已逝去大半，還剩下什麼？",
      "hasZh": true,
      "placeholder": false,
      "mappedToEnglish": true,
      "mappedToZhKey": true,
      "zhKeyValue": "當當年的你已逝去大半，還剩下什麼？"
    },
    {
      "id": "4",
      "timecode": "00:00:18,836 --> 00:00:20,541",
      "english": "When I think about growing old,",
      "zh": "想到變老，",
      "hasZh": true,
      "placeholder": false,
      "mappedToEnglish": true,
      "mappedToZhKey": true,
      "zhKeyValue": "想到變老，"
    },
    {
      "id": "5",
      "timecode": "00:00:20,810 --> 00:00:22,785",
      "english": "I don't have to imagine very much.",
      "zh": "我不用費力想像。",
      "hasZh": true,
      "placeholder": false,
      "mappedToEnglish": true,
      "mappedToZhKey": true,
      "zhKeyValue": "我不用費力想像。"
    },
    {
      "id": "6",
      "timecode": "00:00:23,772 --> 00:00:25,860",
      "english": "My grandmother had a stroke and spent",
